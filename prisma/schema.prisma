generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------
// Enums
// ----------------------------------------------------

enum OrderStatus {
  CREATED
  PAYMENT_PENDING
  PAID
  PAYMENT_FAILED
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUND_PENDING
  REFUNDED
}

enum PaymentStatus {
  CREATED
  AUTHORIZED
  CAPTURED
  FAILED
  REFUND_PENDING
  REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_SHIPPED
  SHIPPED
  DELIVERED
  RETURN_REQUESTED
  RETURNED
}

enum AddressType {
  BILLING
  SHIPPING
}

enum PaymentTransactionStatus {
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum InventoryReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
}

enum ShipmentStatus {
  PENDING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
}

enum TrackingStatus {
  PENDING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
}

enum DeliveryAttemptStatus {
  FAILED
  SUCCESS
}

enum WebhookEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum ERPSyncStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ReturnRequestStatus {
  PENDING
  APPROVED
  REJECTED
  RECEIVED
}

enum RefundStatus {
  PENDING
  COMPLETED
  FAILED
}

enum SampleRequestStatus {
  PENDING
  APPROVED
  REJECTED
  FULFILLED
}

// ----------------------------------------------------
// Core E-Commerce Entities
// ----------------------------------------------------

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([isDeleted])
}

model Media {
  id        String   @id @default(uuid())
  url       String
  alt       String?
  type      String   @default("IMAGE") // IMAGE, VIDEO
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productPrimaryImages Product[]      @relation("PrimaryImage")
  productImages        ProductImage[]
  variantImages        VariantImage[]
  cmsBanners           Banner[]
  cmsMedia             CmsMedia[]
}

model Collection {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products ProductCollection[]
}

model Tag {
  id   String @id @default(uuid())
  name String @unique
  slug String @unique

  products ProductTag[]
}

model Product {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])

  // Food Industry Specifics
  ingredients         String? @db.Text
  nutritionalInfo     String? @db.Text
  shelfLifeDays       Int?
  storageInstructions String? @db.Text
  countryOfOrigin     String  @default("India")
  fssaiLicense        String?
  hsnCode             String?
  gstRate             Decimal @default(0) @db.Decimal(5, 2)

  // Preparation Guides
  fryingTemp          String?
  airFryerSetting     String?
  microwaveTime       String?

  // Dynamic Filters
  spiceLevel          String?
  dietType            String?
  region              String?
  mealPairing         String?

  // Subscriptions
  isSubscribable              Boolean @default(false)
  subscriptionDiscountPercent Float   @default(0)

  // Merchandising & Discoverability
  isFeatured     Boolean  @default(false)
  searchKeywords String[] // Array of keywords

  primaryImageId String?
  primaryImage   Media?  @relation("PrimaryImage", fields: [primaryImageId], references: [id])

  // SEO Fields
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?

  // State
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  variants    ProductVariant[]
  reviews     Review[]
  images      ProductImage[]
  collections ProductCollection[]
  tags        ProductTag[]
  badges      ProductBadge[]
  bundleRules BundleRuleProduct[]
  subscriptions CustomerSubscription[]

  relatedProducts            RelatedProduct[]           @relation("ProductToRelated")
  relatedTo                  RelatedProduct[]           @relation("RelatedToProduct")
  frequentlyBoughtTogether   FrequentlyBoughtTogether[] @relation("ProductToFBT")
  frequentlyBoughtTogetherOf FrequentlyBoughtTogether[] @relation("FBTToProduct")
  recentlyViewed             RecentlyViewed[]
  recommendations            Recommendation[]

  @@index([categoryId])
  @@index([isDeleted])
  @@index([isFeatured])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  sortOrder Int     @default(0)

  @@unique([productId, mediaId])
}

model ProductCollection {
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
}

model ProductTag {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model Badge {
  id        String   @id @default(uuid())
  name      String   @unique
  icon      String?
  bgColor   String?
  textColor String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products ProductBadge[]
}

model ProductBadge {
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge   @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([productId, badgeId])
}

model RelatedProduct {
  id             String  @id @default(uuid())
  productId      String
  product        Product @relation("ProductToRelated", fields: [productId], references: [id], onDelete: Cascade)
  relatedId      String
  relatedProduct Product @relation("RelatedToProduct", fields: [relatedId], references: [id], onDelete: Cascade)
  score          Float?  @default(1.0)

  @@unique([productId, relatedId])
}

model FrequentlyBoughtTogether {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation("ProductToFBT", fields: [productId], references: [id], onDelete: Cascade)
  relatedId String
  related   Product @relation("FBTToProduct", fields: [relatedId], references: [id], onDelete: Cascade)
  frequency Int     @default(1)

  @@unique([productId, relatedId])
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  itemCode       String   @unique // ERP SKU
  barcode        String?  @unique
  name           String // e.g., "250g Pack", "500g Pack"
  price          Decimal  @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  wholesalePrice Decimal? @db.Decimal(10, 2)

  // Physical properties
  weightGrams Float?
  length      Float?
  width       Float?
  height      Float?

  // State
  isBestValue Boolean  @default(false)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems      OrderItem[]
  reservations    InventoryReservation[]
  wishlistItems   WishlistItem[]
  inventoryLevels InventoryLevel[]
  images          VariantImage[]

  @@index([isDeleted])
  @@index([productId])
}

model VariantImage {
  id               String         @id @default(uuid())
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  mediaId          String
  media            Media          @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([productVariantId, mediaId])
}

model Review {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  rating     Int // 1 to 5
  title      String?
  comment    String? @db.Text
  isApproved Boolean @default(false)
  isFeatured Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------
// User & Auth
// ----------------------------------------------------

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions Permission[]
  users       User[]
}

model Permission {
  id          String  @id @default(uuid())
  action      String // e.g. "read", "write", "manage"
  resource    String // e.g. "orders", "products", "all"
  description String?

  roles Role[]

  @@unique([action, resource])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  phone         String?
  erpId         String?   @unique // ERP Customer ID
  roleId        String?
  role          Role?     @relation(fields: [roleId], references: [id])
  isB2B         Boolean   @default(false)
  gstin         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts                Account[]
  sessions                Session[]
  orders                  Order[]
  addresses               Address[]
  reviews                 Review[]
  wishlist                Wishlist?
  loyaltyAccount          LoyaltyAccount?
  returnRequests          ReturnRequest[]
  recentlyViewed          RecentlyViewed[]
  savedSearches           SavedSearch[]
  recommendations         Recommendation[]
  notificationPreferences NotificationPreference?
  referrals               Referral[]              @relation("Referrer")
  referredBy              Referral?               @relation("ReferredUser")
  giftCards               GiftCard[]
  subscriptions           CustomerSubscription[]
  sampleRequests          SampleRequest[]
}

model Address {
  id     String      @id @default(uuid())
  userId String
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   AddressType

  firstName         String
  lastName          String
  company           String?
  flatOrHouseNumber String
  localityOrArea    String
  landmark          String?
  city              String
  state             String
  pincode           String
  country           String  @default("India")
  phone             String?

  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ----------------------------------------------------
// Order Management
// ----------------------------------------------------

model Coupon {
  id            String   @id @default(uuid())
  code          String   @unique
  description   String?
  discountType  String // PERCENTAGE, FIXED
  discountValue Decimal  @db.Decimal(10, 2)
  minOrderValue Decimal? @db.Decimal(10, 2)
  maxDiscount   Decimal? @db.Decimal(10, 2)
  usageLimit    Int?
  perUserLimit  Int?
  usedCount     Int      @default(0)
  validFrom     DateTime
  validUntil    DateTime
  isActive      Boolean  @default(true)
  isPromoted    Boolean  @default(false)
  promotedProductId String?
  promotedTitle     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

model BundleRule {
  id          String   @id @default(uuid())
  name        String
  description String?
  size        Int
  price       Decimal  @db.Decimal(10, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products BundleRuleProduct[]
}

model BundleRuleProduct {
  bundleRuleId String
  bundleRule   BundleRule @relation(fields: [bundleRuleId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([bundleRuleId, productId])
}

model CustomerSubscription {
  id                     String   @id @default(uuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId              String
  product                Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty                    Int
  frequency              String   @default("MONTHLY") // e.g. MONTHLY
  status                 String   @default("ACTIVE") // ACTIVE, PAUSED, CANCELLED
  razorpaySubscriptionId String?  @unique
  nextBillingDate        DateTime
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

model Order {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Financials
  subTotal      Decimal @db.Decimal(10, 2)
  taxTotal      Decimal @db.Decimal(10, 2)
  cgstTotal     Decimal @default(0) @db.Decimal(10, 2)
  sgstTotal     Decimal @default(0) @db.Decimal(10, 2)
  igstTotal     Decimal @default(0) @db.Decimal(10, 2)
  shippingTotal Decimal @db.Decimal(10, 2)
  discountTotal Decimal @db.Decimal(10, 2)
  total         Decimal @db.Decimal(10, 2)

  couponId String?
  coupon   Coupon? @relation(fields: [couponId], references: [id])

  shippingAddress Json?
  billingAddress  Json?

  status            OrderStatus       @default(CREATED)
  paymentMethod     String            @default("RAZORPAY") // RAZORPAY, COD
  paymentStatus     PaymentStatus     @default(CREATED)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items          OrderItem[]
  payments       PaymentTransaction[]
  shipments      Shipment[]
  syncLogs       ERPSync[]
  returnRequests ReturnRequest[]
  refunds        Refund[]
  invoice        Invoice?
}

model OrderItem {
  id               String         @id @default(uuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])
  qty              Int
  rate             Decimal        @db.Decimal(10, 2) // Price at time of purchase
  taxRate          Decimal        @db.Decimal(10, 2) // GST rate applied
  taxAmount        Decimal        @db.Decimal(10, 2)
  cgstAmount       Decimal        @default(0) @db.Decimal(10, 2)
  sgstAmount       Decimal        @default(0) @db.Decimal(10, 2)
  igstAmount       Decimal        @default(0) @db.Decimal(10, 2)
  total            Decimal        @db.Decimal(10, 2)
}

model Invoice {
  id            String   @id @default(uuid())
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoiceNumber String   @unique // e.g., INV-2026-000001
  issuedAt      DateTime @default(now())

  sellerGstin  String?
  buyerDetails Json // Snapshot of buyer name, email, phone, billing & shipping addresses
  lineItems    Json // Snapshot of items with tax split and rates
  taxTotals    Json // Snapshot of overall tax (total, cgst, sgst, igst)

  createdAt DateTime @default(now())
}

// ----------------------------------------------------
// Inventory, Payments & Shipping
// ----------------------------------------------------

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  location  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventoryLevels InventoryLevel[]
}

model InventoryLevel {
  id               String         @id @default(uuid())
  warehouseId      String
  warehouse        Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  available Int @default(0)
  reserved  Int @default(0)
  committed Int @default(0)
  sold      Int @default(0)
  damaged   Int @default(0)
  returned  Int @default(0)

  updatedAt DateTime @updatedAt

  @@unique([warehouseId, productVariantId])
}

model InventoryReservation {
  id               String         @id @default(uuid())
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  orderId          String?
  qty              Int
  expiresAt        DateTime
  status           InventoryReservationStatus @default(ACTIVE) // ACTIVE, COMMITTED, RELEASED
  createdAt        DateTime       @default(now())

  @@index([status, expiresAt])
}

model PaymentTransaction {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("INR")
  provider      String   @default("razorpay")
  transactionId String   @unique // e.g., razorpay_payment_id
  status        PaymentTransactionStatus // AUTHORIZED, CAPTURED, FAILED, REFUNDED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  audits PaymentAudit[]
}

model PaymentAudit {
  id                   String             @id @default(uuid())
  paymentTransactionId String
  paymentTransaction   PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Cascade)
  action               String
  details              Json?
  createdAt            DateTime           @default(now())
}

model Shipment {
  id           String    @id @default(uuid())
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  trackingCode String?
  courier      String? // e.g., Delhivery, BlueDart via Shiprocket
  status       ShipmentStatus // PENDING, SHIPPED, OUT_FOR_DELIVERY, DELIVERED
  dispatchedAt DateTime?
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  items            ShipmentItem[]
  packages         Package[]
  trackingUpdates  Tracking[]
  deliveryAttempts DeliveryAttempt[]
}

model ShipmentItem {
  id          String   @id @default(uuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItemId String
  qty         Int
}

model Package {
  id           String   @id @default(uuid())
  shipmentId   String
  shipment     Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  weightGrams  Float?
  length       Float?
  width        Float?
  height       Float?
  trackingCode String?
}

model Tracking {
  id          String   @id @default(uuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      TrackingStatus
  location    String?
  description String?
  timestamp   DateTime @default(now())
}

model DeliveryAttempt {
  id          String   @id @default(uuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  attemptedAt DateTime @default(now())
  status      DeliveryAttemptStatus // FAILED, SUCCESS
  reason      String?
}

// ----------------------------------------------------
// Event-Driven & Async Infrastructure
// ----------------------------------------------------

model WebhookEvent {
  id          String    @id @default(uuid())
  provider    String // e.g., razorpay, erpnext, shiprocket
  eventType   String // e.g., payment.captured, order.shipped
  payload     Json
  status      WebhookEventStatus @default(PENDING) // PENDING, PROCESSING, PROCESSED, FAILED
  error       String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([provider, eventType, status])
}

model OutboxEvent {
  id            String   @id @default(uuid())
  aggregateId   String // ID of the entity that changed
  aggregateType String // e.g., Order, Customer
  eventType     String // e.g., OrderPaid
  payload       Json
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  
  @@index([published])
}

model ERPSync {
  id           String   @id @default(uuid())
  entityType   String // e.g., Order, Customer, Product
  entityId     String // ID in our local DB
  targetSystem String   @default("erpnext")
  targetId     String? // e.g., ERPNext Sales Order name
  status       ERPSyncStatus // PENDING, SUCCESS, FAILED
  attempts     Int      @default(0)
  lastError    String?
  orderId      String?
  order        Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  history SyncHistory[]

  @@index([entityType, entityId, status])
}

model SyncHistory {
  id        String   @id @default(uuid())
  syncId    String
  sync      ERPSync  @relation(fields: [syncId], references: [id], onDelete: Cascade)
  status    String
  message   String?
  createdAt DateTime @default(now())
}

// ----------------------------------------------------
// Admin CMS & Audit
// ----------------------------------------------------

model CmsPage {
  id              String    @id @default(uuid())
  title           String
  slug            String    @unique
  status          String    @default("DRAFT") // DRAFT, PUBLISHED, SCHEDULED, ARCHIVED
  type            String    @default("PAGE") // PAGE, STORY
  excerpt         String?   @db.Text
  featuredImage   String?
  publishedAt     DateTime?
  activeVersionId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  versions CmsPageVersion[]
}

model CmsPageVersion {
  id        String   @id @default(uuid())
  pageId    String
  page      CmsPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)
  version   Int
  content   Json
  createdBy String?
  createdAt DateTime @default(now())

  @@unique([pageId, version])
}

model CmsBlock {
  id        String   @id @default(uuid())
  key       String   @unique
  type      String // html, json, text
  content   String   @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Navigation {
  id        String   @id @default(uuid())
  handle    String   @unique
  items     Json // Array of links
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Footer {
  id        String   @id @default(uuid())
  handle    String   @unique
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Banner {
  id        String   @id @default(uuid())
  title     String
  subtitle  String?
  link      String?
  mediaId   String?
  media     Media?   @relation(fields: [mediaId], references: [id])
  isActive  Boolean  @default(true)
  validFrom DateTime?
  validUntil DateTime?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SEO {
  id          String   @id @default(uuid())
  entityType  String // Product, Category, CmsPage
  entityId    String
  title       String?
  description String?
  keywords    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([entityType, entityId])
}

model CmsMedia {
  id        String   @id @default(uuid())
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  usage     String
  createdAt DateTime @default(now())
}

model Settings {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String? // Who performed the action
  action    String // e.g., PRODUCT_UPDATED, ORDER_REFUNDED
  entity    String // e.g., Product, Order
  entityId  String
  details   Json? // Changes made
  ipAddress String?
  createdAt DateTime @default(now())
}

// ----------------------------------------------------
// Customer Features (Wishlist, Loyalty, Returns)
// ----------------------------------------------------

model Wishlist {
  id        String         @id @default(uuid())
  userId    String         @unique
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model WishlistItem {
  id               String         @id @default(uuid())
  wishlistId       String
  wishlist         Wishlist       @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  addedAt          DateTime       @default(now())

  @@unique([wishlistId, productVariantId])
}

model RecentlyViewed {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@unique([userId, productId])
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SavedSearch {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query     String
  createdAt DateTime @default(now())
}

model Recommendation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  score     Float
  createdAt DateTime @default(now())
}

model NotificationPreference {
  id          String  @id @default(uuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailOrders Boolean @default(true)
  emailPromos Boolean @default(false)
  smsOrders   Boolean @default(true)
  smsPromos   Boolean @default(false)
}

model EventLog {
  id        String   @id @default(uuid())
  eventName String // e.g., page_view, add_to_cart, checkout
  userId    String?
  sessionId String?
  url       String?
  metadata  Json?
  createdAt DateTime @default(now())
}

model LoyaltyAccount {
  id            String               @id @default(uuid())
  userId        String               @unique
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  pointsBalance Int                  @default(0)
  tier          String               @default("BRONZE") // BRONZE, SILVER, GOLD
  transactions  LoyaltyTransaction[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
}

model LoyaltyTransaction {
  id               String         @id @default(uuid())
  loyaltyAccountId String
  loyaltyAccount   LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)
  points           Int // Positive for earn, negative for redeem
  type             String // EARN_ORDER, REDEEM_ORDER, BONUS
  orderId          String? // Reference to Order if applicable
  description      String?
  createdAt        DateTime       @default(now())
}

model Referral {
  id             String   @id @default(uuid())
  referrerId     String
  referrer       User     @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredUserId String?  @unique
  referredUser   User?    @relation("ReferredUser", fields: [referredUserId], references: [id])
  code           String   @unique
  status         String   @default("PENDING") // PENDING, SUCCESS
  createdAt      DateTime @default(now())
}

model GiftCard {
  id             String    @id @default(uuid())
  code           String    @unique
  balance        Decimal   @db.Decimal(10, 2)
  initialBalance Decimal   @db.Decimal(10, 2)
  currency       String    @default("INR")
  purchaserId    String?
  purchaser      User?     @relation(fields: [purchaserId], references: [id])
  recipientEmail String?
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model ReturnRequest {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String
  status    ReturnRequestStatus @default(PENDING) // PENDING, APPROVED, REJECTED, RECEIVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refunds Refund[]
}

model Refund {
  id              String         @id @default(uuid())
  returnRequestId String?
  returnRequest   ReturnRequest? @relation(fields: [returnRequestId], references: [id], onDelete: SetNull)
  orderId         String
  order           Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount          Decimal        @db.Decimal(10, 2)
  reason          String?
  status          RefundStatus   @default(PENDING) // PENDING, COMPLETED, FAILED
  transactionId   String? // Gateway refund ID
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

// ----------------------------------------------------
// System & Admin
// ----------------------------------------------------

model FeatureFlag {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String?
  isEnabled   Boolean  @default(false)
  rules       Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  type      String // EMAIL, SMS, PUSH
  subject   String?
  body      String   @db.Text
  variables Json?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvoiceSequence {
  id        String   @id @default(uuid())
  year      Int      @unique
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------
// B2B & Wholesale
// ----------------------------------------------------

model SampleRequest {
  id           String              @id @default(uuid())
  userId       String?
  user         User?               @relation(fields: [userId], references: [id])
  businessName String
  contactName  String
  email        String
  phone        String
  address      Json
  status       SampleRequestStatus @default(PENDING) // PENDING, APPROVED, REJECTED, FULFILLED
  notes        String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

// ----------------------------------------------------
// Shipping Zones & Serviceability (Phase 3)
// ----------------------------------------------------

model ShippingZone {
  id              String               @id @default(cuid())
  name            String
  estimatedDays   String
  rate            Float                @default(0)
  isServiceable   Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  pincodes        ServiceablePincode[]
}

model ServiceablePincode {
  pincode      String        @id
  zoneId       String
  zone         ShippingZone  @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([zoneId])
}
