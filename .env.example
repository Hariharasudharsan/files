# Public storefront settings. These must not contain secrets.
NEXT_PUBLIC_SITE_URL=https://www.mathuramfoods.com
NEXT_PUBLIC_IMAGE_HOST=https://your-cdn-or-erp-image-host.com

# Server-only ERP integration settings. ERPNext is an external system, not the
# storefront backend, so these are only used by async sync workers/webhooks.
ERP_BASE_URL=https://your-erpnext-instance.com
ERP_AUTH_TOKEN=token your_api_key:your_api_secret
ERP_WEBHOOK_SECRET=replace-with-a-random-shared-secret
