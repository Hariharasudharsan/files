# Public storefront settings. These must not contain secrets.
NEXT_PUBLIC_SITE_URL=https://www.mathuramfoods.com
NEXT_PUBLIC_IMAGE_HOST=https://your-cdn-or-erp-image-host.com

# Core Backend Infrastructure
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=mathuram_db
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token
AUTH_SECRET=generate-a-secure-random-32-byte-string-here
NEXTAUTH_SECRET=generate-a-secure-random-32-byte-string-here # Use a random string in production (e.g., openssl rand -base64 32)
# Server-only ERP integration settings. ERPNext is an external system, not the
# storefront backend, so these are only used by async sync workers/webhooks.
ERPNEXT_URL=https://your-erpnext-instance.com
ERPNEXT_API_KEY=your_api_key
ERPNEXT_API_SECRET=your_api_secret
ERPNEXT_WEBHOOK_SECRET=replace-with-a-random-shared-secret
 
# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_yourkeyid
RAZORPAY_KEY_SECRET=yoursecret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret