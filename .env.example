# Public — safe to expose to the browser. Used both server-side (API calls)
# and client-side (constructing product image URLs), so it must NOT contain
# any secret.
NEXT_PUBLIC_ERPNEXT_URL=https://your-erpnext-instance.com

# Secret — server-only. Never prefix this with NEXT_PUBLIC_, or it will be
# bundled into client-side JavaScript and visible to anyone who views source.
# Format: "token API_KEY:API_SECRET" (see ERPNext > Settings > API Access).
ERPNEXT_AUTH_TOKEN=token your_api_key:your_api_secret
